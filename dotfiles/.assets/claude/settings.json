{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "skillListingMaxDescChars": 2048,
  "skillListingBudgetFraction": 0.02,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(git branch:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(uv sync:*)",
      "Bash(wc:*)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "Edit(//tmp/**)",
      "Read(//tmp/**)",
      "Read(**/sessionmemory-vault/**)",
      "Edit(**/sessionmemory-vault/**)"
    ],
    "deny": [
      "Bash(git add -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(**/.env.secret)",
      "Edit(**/.env.secrets)",
      "Edit(**/.env)",
      "Read(.envrc)",
      "Read(**/.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(~/.aws/**)",
      "Bash(rip:*)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(uvx:*)",
      "Bash(chmod 777:*)",
      "Bash(eval:*)",
      "Bash(git tag:*)",
      "Bash(git checkout main:*)",
      "Bash(git clean -fd:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git switch main:*)",
      "Bash(git merge:*)"
    ],
    "additionalDirectories": [
      "/private/tmp"
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/natelandau/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true,
    "natelandau-toolkit@natelandau-cc-plugin": true,
    "swift-lsp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "sessionmemory@sessionmemory": true
  },
  "extraKnownMarketplaces": {
    "natelandau-cc-plugin": {
      "source": {
        "source": "github",
        "repo": "natelandau/cc-plugin"
      },
      "autoUpdate": true
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "sessionmemory": {
      "source": {
        "source": "github",
        "repo": "natelandau/sessionmemory"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    }
  }
}
