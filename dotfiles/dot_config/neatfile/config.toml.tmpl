{{- if (lookPath "neatfile") -}}

# neatfile configuration
# Global settings apply to every run. A [projects.NAME] section below can
# override any of them for that project.
# Settings written as comments show the default value neatfile uses.

# Which part comes first in an ambiguous all-number date, such as 03-04-12
# or 120524. Options: "month", "day", "year".
# date_first = "month"

# Format of the date that neatfile adds to each filename, using Python
# strftime codes. An empty string adds no date and removes dates from names.
# A date that names only a month, week, quarter, half year, or year keeps a
# short form, such as 2025-03 or 2024-Q3, instead of this format.
date_format = "%Y-%m-%d"

# Skip dotfiles (names that start with a period) when cleaning a directory.
# true or false
ignore_dotfiles = true

# Skip files whose names match this regular expression. An empty string
# skips nothing. Keep the single quotes so backslashes stay literal.
ignore_file_regex = ''

# File names to skip, such as recurring files that should keep their names.
ignored_files = []

# Where the date goes in the filename. Options: "before", "after".
# insert_location = "before"

# Words whose capitalization neatfile keeps exactly as written here,
# such as acronyms and proper nouns. neatfile never removes these words.
match_case_list = [
